# Example configuration for lakehouse-schema-extraction.
#
#   cp .env.example .env
#
# Everything here has a working default, so .env is optional -- copy it only when you
# want to point at a different catalog, database, or lakehouse. It is read by both
# `just` (via `set dotenv-load`) and docker-compose, so the two never disagree.
#
# .env is gitignored. .env.example is not: keep real credentials out of this file.


# --- what to extract ------------------------------------------------------

# Catalog name exactly as it appears in `just catalogs`. Hyphens are fine; the tools
# quote it for you. The `_postgresql` suffix is a local naming convention -- the actual
# dialect is chosen from the connector name Trino reports.
TARGET_CATALOG=gold-db-2_postgresql

# Schema inside that catalog. Run `just schemas <catalog>` to list the options.
TARGET_SCHEMA=gold

# Where generated .sql, .json, .yaml and the SchemaSpy site are written.
OUT_DIR=out


# --- lakehouse connection -------------------------------------------------

# Override only if you are pointing at a different Starburst instance.
LAKEHOUSE_HOST=lakehouse-pov.jgi.lbl.gov
LAKEHOUSE_PORT=443

# Username recorded against your queries in the Starburst Insights UI. Defaults to your
# local OS username, which is usually right.
#TRINO_USER=jdoe

# LEAVE THIS UNSET for normal use.
#
# Authentication is OAuth2 by default: a browser opens on first use and the token is
# cached in your system keyring. Setting a password here switches to basic auth for
# every run, and puts a real credential in a file on disk. Only use it for headless
# or service accounts, and prefer exporting it in the shell over storing it here.
#TRINO_PASSWORD=


# --- local documentation database ----------------------------------------

# These configure the throwaway Postgres in docker-compose.yaml. They are NOT secrets:
# the container is local, disposable, and holds only the extracted structure -- no rows
# are ever copied out of the source database.
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=golddocs

# Host port for the container. Change this if 5433 is already taken; both `just` and
# compose pick up the new value, so schema-automator still connects correctly.
POSTGRES_PORT=5433
